---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/ico" href="/favicon_io/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
    
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Datos estructurados para LLMs y SEO -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Juan Pedro Gómez Espinosa",
        "alternateName": "Juanpe Gómez",
        "jobTitle": "Desarrollador Web",
        "url": "https://juanpe-gomez.es",
        "sameAs": [
          "https://github.com/TU_USUARIO",
          "https://www.linkedin.com/in/TU_USUARIO"
        ],
        "knowsAbout": [
          "Desarrollo Web",
          "Astro Framework",
          "React",
          "Node.js",
          "Express",
          "Tailwind CSS",
          "MySQL",
          "Cypress",
          "Playwright"
        ],
        "description": "Desarrollador web de perfil junior-mid especializado en arquitecturas full-stack modernas, flujos de automatización y testing de calidad."
      }
    </script>
  </head>
  
  <body>
    <slot />
  </body>
</html>